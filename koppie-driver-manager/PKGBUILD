# Maintainer: Raihan <maularaihan-git>
pkgname=koppie-driver-manager
pkgver=1.0.0
pkgrel=8
pkgdesc="Automatic hardware detection and driver manager for Koppie Linux"
arch=('any')
url="https://github.com/maularaihan-git/koppie-repo"
license=('GPL')
depends=('python' 'tk' 'python-pillow')
optdepends=(
    'linux-headers: headers for building DKMS modules (standard kernel)'
    'linux-lts-headers: headers for building DKMS modules (LTS kernel)'
    'broadcom-wl-dkms: Broadcom Wi-Fi driver for MacBooks and select laptops'
    'nvidia-open-dkms: NVIDIA proprietary driver (DKMS)'
)
source=("$pkgname-$pkgver.tar.gz::https://raw.githubusercontent.com/maularaihan-git/koppie-repo/main/pkg-sources/$pkgname/$pkgname-$pkgver.tar.gz")
sha256sums=('6cb16344ffa9d38e0d39c9ede2a2bca3e9cbfc3b32487ceae9f4db2433bcda28')

package() {
    install -d "$pkgdir/usr/share/koppie/koppie-driver-manager"
    install -d "$pkgdir/usr/bin"
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/share/icons/hicolor/512x512/apps"
    install -d "$pkgdir/usr/share/pixmaps"

    # Copy script and libraries
    cp -r "$srcdir/app/"* "$pkgdir/usr/share/koppie/koppie-driver-manager/"

    # Install app icon (Papirus driver-manager artwork)
    install -m644 "$srcdir/app/assets/koppie-driver-manager-icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/koppie-driver-manager.png"
    install -m644 "$srcdir/app/assets/koppie-driver-manager-icon.png" "$pkgdir/usr/share/pixmaps/koppie-driver-manager.png"

    # Wrapper script in /usr/bin
    cat << 'EOF' > "$pkgdir/usr/bin/koppie-driver-manager"
#!/usr/bin/env bash
python3 /usr/share/koppie/koppie-driver-manager/koppie_driver_manager.py "$@"
EOF
    chmod +x "$pkgdir/usr/bin/koppie-driver-manager"

    # Desktop file
    cat << 'EOF' > "$pkgdir/usr/share/applications/koppie-driver-manager.desktop"
[Desktop Entry]
Name=Koppie Driver Manager
Comment=Detect hardware and manage drivers for Koppie Linux
Exec=koppie-driver-manager
Icon=koppie-driver-manager
Terminal=false
Type=Application
Categories=System;Settings;HardwareSettings;
StartupNotify=true
StartupWMClass=koppie-driver-manager
EOF
}
